# ========================================================
# cPanel Production Environment — api.meseretmare.com
# ========================================================
# Copy this file to .env on your cPanel server and fill
# in the real values from your cPanel MySQL Databases page.
# ========================================================

NODE_ENV=production
PORT=4000

# --- Frontend origin (for CORS) ---
FRONTEND_ORIGIN=https://app.meseretmare.com

# --- MySQL Database (from cPanel → MySQL Databases) ---
# Format: mysql://cpaneluser_dbuser:password@localhost:3306/cpaneluser_dbname
DATABASE_URL="mysql://cpaneluser_dbuser:YOUR_DB_PASSWORD@localhost:3306/cpaneluser_solarflow"

# --- JWT Secrets (generate with: openssl rand -hex 32) ---
JWT_ACCESS_SECRET="REPLACE-WITH-64-CHAR-RANDOM-HEX"
JWT_REFRESH_SECRET="REPLACE-WITH-ANOTHER-64-CHAR-RANDOM-HEX"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# --- Initial Admin Credentials ---
DEFAULT_MANAGER_USERNAME=manager
DEFAULT_MANAGER_PASSWORD=CHANGE_THIS_PASSWORD

# --- Sync API Key ---
SYNC_API_KEY="REPLACE-WITH-RANDOM-API-KEY"
