# Application Environment Configuration
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Database Connection (MySQL / TiDB Cloud)
DATABASE_URL="mysql://root@localhost:3306/solarflow"

# Production Authentication Secrets (Required in Production)
JWT_ACCESS_SECRET="generate-64-character-random-hex-string-for-access-token"
JWT_REFRESH_SECRET="generate-64-character-random-hex-string-for-refresh-token"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# Initial Bootstrapping Admin Credentials (Option A)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
